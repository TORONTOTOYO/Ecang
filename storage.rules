// Paste these into: Firebase console > Storage > Rules > Publish
// Replace PASTE_ADMIN_GMAIL_HERE with your admin Gmail address (all lowercase).
//
// Everyone can VIEW photos. Only the admin Gmail account can upload (images under 5 MB).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "caguioaericamae@gmail.com"
          && request.auth.token.email_verified == true;
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
