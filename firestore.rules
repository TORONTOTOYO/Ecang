// Paste these into: Firebase console > Firestore Database > Rules > Publish
// Replace PASTE_ADMIN_UID_HERE with the admin's User UID
// (Firebase console > Authentication > Users > copy "User UID").
//
// Everyone can READ the website content. Only the admin can CHANGE it.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "N7zFz26dVQdQ2wCVsX6Wg54ndqb2";
    }
  }
}
