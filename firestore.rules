// Paste these into: Firebase console > Firestore Database > Rules > Publish
// Replace PASTE_ADMIN_GMAIL_HERE with your admin Gmail address (all lowercase).
//
// Everyone can READ the website content. Only the admin Gmail account can CHANGE it.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "caguioaericamae@gmail.com"
          && request.auth.token.email_verified == true;
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
