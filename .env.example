# Copy this file to ".env" and fill in the values from your Firebase project:
# Firebase console > Project settings (gear icon) > Your apps > Web app > Config
# After changing .env, stop and restart "npm run dev".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The ONLY Gmail address allowed to use the admin panel (all lowercase)
VITE_ADMIN_EMAIL=you@gmail.com
